generator client {
  provider = "prisma-client-js"
}

generator nextClient {
  provider = "prisma-client-js"
  output   = "../../orvix/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("platform_admin")
  designation   String?
  designationOther String?
  extraPermissions   String[] @default([])
  revokedPermissions String[] @default([])
  assignedProjectIds String[] @default([])
  assignedSiteIds    String[] @default([])
  ngoId         String?
  ngo           Ngo?      @relation(fields: [ngoId], references: [id], onDelete: SetNull)
  phone         String?
  employeeId    String?
  address       String?
  joiningDate   DateTime?
  status        String    @default("active")
  mfaEnabled    Boolean   @default(false)
  twoFactorEnabled Boolean @default(false)
  sessions      Session[]
  accounts      Account[]
  twofactors    TwoFactor[]
  salary        WorkerSalary?
  salaryPeriods SalaryPeriod[]
  attendance    AttendanceRecord[]
  leaveRequests LeaveRequest[]
  notifications Notification[]
  activities    Activity[]
  dataEntries   DataEntryRecord[]

  @@unique([email])
  @@index([ngoId])
  @@index([role])
  @@index([ngoId, employeeId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([issuer, accountId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

model WorkerSalary {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoId        String
  ngo          Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  basicSalary  Decimal  @db.Decimal(12, 2)
  salaryType   String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ngoId])
  @@index([status])
}

model SalaryPeriod {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoId            String
  ngo              Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  periodStart      DateTime @db.Date
  periodEnd        DateTime @db.Date
  workingDays      Int
  presentDays      Int
  absentDays       Int
  paidLeaveDays    Int
  unpaidLeaveDays  Int
  totalSalary      Decimal  @db.Decimal(12, 2)
  totalDeduction   Decimal  @db.Decimal(12, 2)
  payableSalary    Decimal  @db.Decimal(12, 2)
  dailyRate        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, periodStart, periodEnd])
  @@index([ngoId])
}

model Ngo {
  id              String   @id @default(cuid())
  name            String
  code            String?  @unique
  category        String
  categoryOther   String?
  description     String?
  logoUrl         String?
  registrationNo  String?
  contactEmail    String
  contactPhone    String
  address         String
  country         String?
  status          String   @default("active")
  enabledModules  String[] @default([])
  mfaEnabled      Boolean  @default(false)
  sharePointEnabled Boolean @default(false)
  sharePointSiteUrl String?
  sharePointLibrary String?
  timezone        String?
  currency        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
  projects        Project[]
  sites           Site[]
  inventoryItems  InventoryItem[]
  inventoryCategories InventoryCategory[]
  stockTransactions StockTransaction[]
  stockTransfers  StockTransfer[]
  stockAdjustments StockAdjustment[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  purchases       Purchase[]
  receivingRecords ReceivingRecord[]
  resourceRequests ResourceRequest[]
  distributions   DistributionRecord[]
  attendance      AttendanceRecord[]
  salaries        WorkerSalary[]
  salaryPeriods   SalaryPeriod[]
  leaveRequests   LeaveRequest[]
  documents       Document[]
  activities      Activity[]
  dataEntries     DataEntryRecord[]
  notifications   Notification[]

  @@index([status])
  @@index([category])
}

model Project {
  id          String    @id @default(cuid())
  ngoId       String
  ngo         Ngo       @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name        String
  description String?
  manager     String?
  status      String    @default("active")
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sites       Site[]
  activities  Activity[]

  @@index([ngoId])
  @@index([status])
}

model Site {
  id          String    @id @default(cuid())
  ngoId       String
  ngo         Ngo       @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  location    String?
  description String?
  status      String    @default("active")
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ngoId])
  @@index([projectId])
  @@index([status])
}

model InventoryCategory {
  id          String   @id @default(cuid())
  ngoId       String
  ngo         Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       InventoryItem[]

  @@unique([ngoId, name])
  @@index([ngoId])
}

model InventoryItem {
  id          String   @id @default(cuid())
  ngoId       String
  ngo         Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  description String?
  categoryId  String?
  category    InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit        String?  @default("pcs")
  quantity    Int      @default(0)
  minLevel    Int      @default(0)
  status      String   @default("active")
  projectId   String?
  siteId      String?
  warehouse   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions StockTransaction[]
  adjustments  StockAdjustment[]
  receiving    ReceivingRecord[]
  requests     ResourceRequest[]
  distributions DistributionRecord[]
  transfers    StockTransfer[]

  @@index([ngoId])
  @@index([categoryId])
  @@index([status])
  @@unique([ngoId, sku])
}

model StockTransaction {
  id              String   @id @default(cuid())
  ngoId           String
  ngo             Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  itemId          String?
  item            InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  type            String
  sku             String
  quantity        Int
  quantityBefore  Int      @default(0)
  quantityAfter   Int      @default(0)
  unitCost        Decimal? @db.Decimal(12, 2)
  totalCost       Decimal? @db.Decimal(12, 2)
  supplierId      String?
  workerId        String?
  projectId       String?
  siteId          String?
  reference       String?
  notes           String?
  createdBy       String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([ngoId])
  @@index([itemId])
  @@index([type])
  @@index([date])
}

model StockTransfer {
  id         String   @id @default(cuid())
  ngoId      String
  ngo        Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku        String
  quantity   Int
  from       String
  to         String
  fromSiteId String?
  toSiteId   String?
  status     String   @default("completed")
  notes      String?
  createdBy  String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([ngoId])
}

model StockAdjustment {
  id             String   @id @default(cuid())
  ngoId          String
  ngo            Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  itemId         String?
  item           InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku            String
  quantity       Int
  quantityBefore Int      @default(0)
  quantityAfter  Int      @default(0)
  reason         String?
  createdBy      String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([ngoId])
}

model Supplier {
  id         String   @id @default(cuid())
  ngoId      String
  ngo        Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name       String
  contact    String?
  email      String?
  phone      String?
  address    String?
  category   String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiving  ReceivingRecord[]

  @@index([ngoId])
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  ngoId     String
  ngo       Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  supplier  String
  status    String   @default("open")
  total     Decimal  @default(0) @db.Decimal(12, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases Purchase[]
  receiving ReceivingRecord[]

  @@index([ngoId])
}

model Purchase {
  id        String   @id @default(cuid())
  ngoId     String
  ngo       Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  orderId   String?
  order     PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  status    String   @default("posted")
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([ngoId])
}

model ReceivingRecord {
  id         String   @id @default(cuid())
  ngoId      String
  ngo        Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  orderId    String?
  order      PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku        String
  quantity   Int
  unitCost   Decimal? @db.Decimal(12, 2)
  totalCost  Decimal? @db.Decimal(12, 2)
  projectId  String?
  siteId     String?
  reference  String?
  notes      String?
  createdBy  String?
  status     String   @default("accepted")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([ngoId])
  @@index([itemId])
}

model ResourceRequest {
  id            String   @id @default(cuid())
  ngoId         String
  ngo           Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  requestedBy   String
  requestedById String?
  itemId        String?
  inventoryItem InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  item          String
  quantity      Int
  projectId     String?
  siteId        String?
  reason        String?
  notes         String?
  status        String   @default("pending")
  decisionNote  String?
  decidedBy     String?
  issuedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ngoId])
  @@index([status])
  @@index([itemId])
}

model DistributionRecord {
  id            String   @id @default(cuid())
  ngoId         String
  ngo           Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  itemId        String?
  inventoryItem InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  workerId      String?
  projectId     String?
  siteId        String?
  item          String
  quantity      Int
  issuedBy      String?
  reason        String?
  notes         String?
  requestId     String?
  status        String   @default("issued")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([ngoId])
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  ngoId     String
  ngo       Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  worker    String
  date      DateTime @db.Date
  status    String
  leavePaid Boolean  @default(false)
  checkInAt DateTime?
  checkOutAt DateTime?
  reason    String?
  siteId    String?
  createdAt DateTime @default(now())

  @@index([ngoId])
  @@index([userId])
  @@index([userId, date])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  ngoId     String
  ngo       Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  worker    String
  type      String
  paid      Boolean  @default(true)
  days      Int
  startsOn  DateTime? @db.Date
  endsOn    DateTime? @db.Date
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ngoId])
}

model Document {
  id        String   @id @default(cuid())
  ngoId     String
  ngo       Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([ngoId])
}

model Activity {
  id         String   @id @default(cuid())
  ngoId      String
  ngo        Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  siteId     String?
  name       String
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  status     String   @default("planned")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ngoId])
}

model DataEntryRecord {
  id         String   @id @default(cuid())
  ngoId      String
  ngo        Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  form       String
  records    Int      @default(0)
  status     String   @default("open")
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ngoId])
}

model Notification {
  id        String   @id @default(cuid())
  ngoId     String?
  ngo       Ngo?     @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  at        DateTime @default(now())
}

model PlatformSettings {
  id                    String  @id @default("platform")
  orgName               String  @default("ORVIX")
  supportEmail          String?
  sessionDays           Int     @default(7)
  mfaRequiredForAdmins  Boolean @default(false)
}
